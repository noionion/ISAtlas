{
  "id": "riscv/manual/csr/hcontext",
  "namespace": "manual",
  "name": "hcontext",
  "title": "Hypervisor-mode context register",
  "summary": "从 HS 态访问 MCONTEXT 的上下文编号。",
  "locator": {
    "type": "riscv-csr",
    "address": 1704
  },
  "privilege": "H",
  "access": "RW",
  "xlens": [
    32,
    64
  ],
  "condition": "Sdtrig；由 tselect 选择触发器，可选实现受规范限制 H；要求实现 MCONTEXT",
  "extensions": [
    "H",
    "Sdtrig"
  ],
  "notes": "Debug 1.0；DM/DMI、JTAG 及调试器虚拟寄存器不属于 hart CSR。 触发器在 Debug Mode 中不触发；DMODE=1 时只有 Debug Mode 可修改配置。功能是否实现需通过规范探测。 HCONTEXT 别名到 MCONTEXT；需要 H 和已实现的 MCONTEXT，HS 访问受 mstateen0.CONTEXT 控制。",
