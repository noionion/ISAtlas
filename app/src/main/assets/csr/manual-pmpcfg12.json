      "values": {
        "0": "未锁定",
        "1": "锁定（受 Smepmp 规则约束）"
      },
      "valuesEn": {
        "0": "Unlocked",
        "1": "Locked, subject to Smepmp"
      },
      "valuesByXlen": {},
      "valuesEnByXlen": {},
