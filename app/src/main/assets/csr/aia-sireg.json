  "name": "sireg",
  "title": "Access the indirect register selected by siselect",
  "summary": "访问 siselect 选中的间接寄存器。",
  "summaryEn": "Access the indirect register selected by siselect.",
  "locator": {
    "type": "riscv-csr",
