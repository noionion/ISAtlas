  "title": "Machine Supervisor Context",
  "summary": "提供旧版 SCONTEXT 兼容别名。",
  "summaryEn": "Provide a legacy alias for SCONTEXT.",
  "privilege": "S",
  "access": "RW",
  "xlens": [
    32,
