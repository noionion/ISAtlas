  "name": "tdata2",
  "title": "Second Debug/Trace trigger data register",
  "summary": "保存所选触发器的比较数据或原因位掩码。",
  "locator": {
    "type": "riscv-csr",
    "address": 1954
  },
  "privilege": "M",
  "access": "RW",
  "xlens": [
