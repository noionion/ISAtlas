            "key": "LCOFIP",
            "patch": {
              "object": {
                "summary": {
                  "set": "计数器溢出待处理位；AIA 下为可写的保持位，可由软件清除，呈现受委托/注入条件控制。"
                },
                "access": {
                  "set": "RW/RO0（依委托和注入条件）"
                },
                "sourceUrl": {
                  "set": "https://github.com/riscv/riscv-aia/blob/20318d1b03f0ac8253458b82f8244d0d0db074e9/src/VSLevel.adoc#L299-L436"
                },
                "summaryEn": {
                  "set": "Sticky, software-clearable counter-overflow pending bit under AIA, subject to delegation/injection controls."
                }
              },
              "remove": []
            }
          },
