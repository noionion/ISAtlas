{
  "id": "riscv/manual/csr/hstateen0h",
  "patch": {
    "object": {
      "extensions": {
        "add": [
          "Smaia",
          "Ssaia"
        ],
        "remove": []
      },
      "fields": {
        "list": "fields",
        "remove": [],
        "items": [
          {
            "key": "IMSIC",
            "patch": {
              "object": {
                "summary": {
                  "set": "控制低特权态访问 IMSIC 状态；无 IMSIC 时读零，不会强制 hgeip/hgeie/VGEIN 为零。"
                },
                "access": {
                  "set": "WARL（可为 RO0）"
                },
                "sourceUrl": {
                  "set": "https://github.com/riscv/riscv-aia/blob/20318d1b03f0ac8253458b82f8244d0d0db074e9/src/CSRs.adoc#L382-L441"
                },
                "summaryEn": {
                  "set": "Control lower-privilege IMSIC access; absent IMSIC reads zero without forcing hgeip/hgeie/VGEIN to zero."
                },
                "condition": {
                  "set": "Smstateen Smaia Ssaia"
                }
              },
              "remove": []
            }
          },
          {
            "key": "AIA",
            "patch": {
              "object": {
                "summary": {
                  "set": "控制不由 CSRIND/IMSIC 管理的 AIA 状态；为 0 时截获低特权态访问。"
                },
                "access": {
                  "set": "WARL（可为 RO0）"
                },
                "sourceUrl": {
                  "set": "https://github.com/riscv/riscv-aia/blob/20318d1b03f0ac8253458b82f8244d0d0db074e9/src/CSRs.adoc#L382-L441"
                },
                "summaryEn": {
                  "set": "Control AIA state outside CSRIND/IMSIC; zero intercepts lower-privilege access."
                },
                "condition": {
                  "set": "Smstateen Smaia Ssaia"
                }
              },
              "remove": []
            }
          },
          {
            "key": "CSRIND",
            "patch": {
              "object": {
                "summary": {
                  "set": "控制低特权态访问 *iselect/*ireg；M 禁止时非法指令，H 禁止时 VS/VU 虚拟指令异常。"
                },
                "access": {
                  "set": "WARL（可为 RO0）"
                },
                "sourceUrl": {
                  "set": "https://github.com/riscv/riscv-aia/blob/20318d1b03f0ac8253458b82f8244d0d0db074e9/src/CSRs.adoc#L382-L441"
                },
                "summaryEn": {
                  "set": "Control lower-privilege indirect CSR access; M denial is illegal instruction, H denial is a virtual instruction exception."
                },
                "condition": {
                  "set": "Smstateen Smaia Ssaia"
                }
              },
              "remove": []
            }
          }
        ]
      },
      "sources": {
        "list": "sources",
        "remove": [],
        "items": [
          {
            "key": "aia",
            "patch": {
              "set": {
                "namespace": "aia",
                "title": "RISC-V Advanced Interrupt Architecture 20250312",
