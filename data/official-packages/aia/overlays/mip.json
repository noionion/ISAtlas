          {
            "key": "SEIP",
            "patch": {
              "object": {
                "summary": {
                  "set": "S 外部中断待处理；mvien.SEIE=0 时含软件注入位，=1 时仅反映外部控制器信号。"
                },
                "access": {
                  "set": "RW（mvien[9]=0）/RO（mvien[9]=1）"
                },
                "sourceUrl": {
                  "set": "https://github.com/riscv/riscv-aia/blob/20318d1b03f0ac8253458b82f8244d0d0db074e9/src/MSLevel.adoc#L506-L616"
                },
                "summaryEn": {
                  "set": "Supervisor external pending; mvien bit 9 separates the software-injected pending bit when set."
                },
                "typeRule": {
                  "set": "无 AIA 或 mvien[9]=0：读取为软件位与外部信号 OR，CSR 读改写仅修改软件位；AIA 且 mvien[9]=1：mip.SEIP 只读，仅反映外部控制器信号，软件位改由 mvip[9] 保存。"
                }
              },
              "remove": []
            }
          },
          {
