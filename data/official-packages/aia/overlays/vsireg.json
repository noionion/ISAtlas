{
  "id": "riscv/manual/csr/vsireg",
  "patch": {
    "object": {
      "extensions": {
        "add": [
          "Smaia",
          "Ssaia"
        ],
        "remove": []
      },
      "notes": {
        "append": " IMSIC：eidelivery 为 WARL（0 禁止、1 允许、0x40000000 可选旁路；guest 不支持旁路）；eithreshold 为 WLRL（0 无阈值，P>0 时仅 ID<P 可递送）。eip/eie 的未实现身份和 ID0 读零。RV64 的奇数 eip/eie selector 访问陷阱；0x71、0x73–0x7F 读零写忽略。 VS 不存在硬件 iprio 数组；selector 0x30–0x3F 不可访问，可由 hypervisor 模拟。有效 guest file 由 hstatus.VGEIN 选择。",
        "join": true
      },
      "fields": {
        "list": "fields",
        "remove": [],
        "items": [
          {
            "key": "DATA",
            "patch": {
              "object": {
                "summary": {
                  "set": "访问 vsiselect 选择的 iprio 或 IMSIC eidelivery/eithreshold/eip/eie；访问属性由所选寄存器决定。"
                },
                "summaryEn": {
                  "set": "Access iprio or IMSIC state selected by vsiselect; access semantics depend on that register."
                },
                "access": {
                  "append": "：WARL/WLRL/RW/RO0",
                  "join": false
                },
                "sourceUrl": {
                  "set": "https://github.com/riscv/riscv-aia/blob/20318d1b03f0ac8253458b82f8244d0d0db074e9/src/IMSIC.adoc#L423-L577"
                }
              },
              "remove": [
                "typeRule",
                "view"
              ]
            }
          }
        ]
      },
      "sources": {
        "list": "sources",
        "remove": [],
        "items": [
          {
            "key": "aia",
            "patch": {
              "set": {
                "namespace": "aia",
                "title": "RISC-V Advanced Interrupt Architecture 20250312",
                "revision": "20318d1b03f0ac8253458b82f8244d0d0db074e9",
                "url": "https://github.com/riscv/riscv-aia/tree/20318d1b03f0ac8253458b82f8244d0d0db074e9",
                "license": "CC-BY-4.0"
              }
            }
          }
        ]
      }
    },
    "remove": []
  }
