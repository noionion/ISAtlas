{
  "id": "riscv/manual/csr/tdata2",
  "patch": {
    "object": {
      "summary": {
        "set": "保存所选触发器的比较数据或原因位掩码。"
      },
      "condition": {
        "set": "Sdtrig；由 tselect 选择触发器，可选实现受规范限制"
      },
      "extensions": {
        "add": [
          "Sdtrig"
        ],
        "remove": []
      },
      "notes": {
        "set": "Debug 1.0；DM/DMI、JTAG 及调试器虚拟寄存器不属于 hart CSR。 触发器在 Debug Mode 中不触发；DMODE=1 时只有 Debug Mode 可修改配置。功能是否实现需通过规范探测。"
      },
      "coverage": {
        "set": "fields"
      },
      "fields": {
        "list": "fields",
        "remove": [],
        "items": [
          {
            "key": "DATA",
            "patch": {
              "set": {
                "name": "DATA",
                "summary": "TYPE=2/6 时用于地址或数据比较；TYPE=4/5 时每位选择中断或异常原因。",
                "summaryEn": "Address/data comparison for TYPE=2/6; interrupt/exception cause bitmap for TYPE=4/5.",
                "access": "WARL",
                "layouts": [
                  {
                    "xlen": 32,
                    "msb": 31,
                    "lsb": 0
                  },
                  {
                    "xlen": 64,
                    "msb": 63,
                    "lsb": 0
                  }
                ],
                "condition": "",
                "aliases": [
                  "data"
                ],
                "sourceUrl": "https://github.com/riscv/riscv-debug-spec/blob/5695c0aaa7a3c228e14702e1268eb5a5e50e3cb8/xml/hwbp_registers.xml#L140-L152",
                "values": {},
                "valuesEn": {},
                "valuesByXlen": {},
                "valuesEnByXlen": {},
                "typeRule": "XLEN<DXLEN 时写入按符号扩展；触发器禁用时可写入该触发器任一支持类型接受的值。",
                "view": ""
              }
            }
          }
        ]
      },
      "summaryEn": {
        "set": "Hold trigger comparison data or cause bitmaps."
      },
      "sources": {
        "list": "sources",
        "remove": [],
        "items": [
          {
            "key": "debug",
            "patch": {
              "set": {
                "namespace": "debug",
                "title": "RISC-V Debug Specification 1.0",
                "revision": "5695c0aaa7a3c228e14702e1268eb5a5e50e3cb8",
                "url": "https://github.com/riscv/riscv-debug-spec/tree/5695c0aaa7a3c228e14702e1268eb5a5e50e3cb8",
                "license": "CC-BY-4.0"
              }
            }
          }
        ]
      }
    },
    "remove": []
  }
}
