              "set": {
                "name": "INDEX",
                "summary": "选择后续触发器 CSR 访问的触发器索引，编号从 0 连续分配。",
                "summaryEn": "Select the trigger accessed by subsequent trigger CSRs; indices are contiguous from zero.",
                "access": "WARL",
                "layouts": [
                  {
                    "xlen": 32,
                    "msb": 31,
                    "lsb": 0
                  },
                  {
                    "xlen": 64,
