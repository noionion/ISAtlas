{
  "id": "riscv/manual/csr/tselect",
  "patch": {
    "object": {
      "summary": {
        "set": "选择要访问的触发器。"
      },
      "condition": {
        "set": "Sdtrig；由 tselect 选择触发器，可选实现受规范限制"
      },
      "extensions": {
        "add": [
          "Sdtrig"
        ],
        "remove": []
      },
      "notes": {
        "set": "Debug 1.0；DM/DMI、JTAG 及调试器虚拟寄存器不属于 hart CSR。 触发器在 Debug Mode 中不触发；DMODE=1 时只有 Debug Mode 可修改配置。功能是否实现需通过规范探测。"
      },
      "coverage": {
        "set": "fields"
      },
      "fields": {
        "list": "fields",
        "remove": [],
        "items": [
          {
            "key": "INDEX",
