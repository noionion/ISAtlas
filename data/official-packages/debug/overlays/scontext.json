{
  "id": "riscv/manual/csr/scontext",
  "patch": {
    "object": {
      "summary": {
        "set": "保存触发器匹配用的监管态上下文编号。"
      },
      "condition": {
        "set": "Sdtrig；由 tselect 选择触发器，可选实现受规范限制"
      },
      "extensions": {
        "add": [
          "Sdtrig"
        ],
        "remove": []
      },
      "notes": {
        "set": "Debug 1.0；DM/DMI、JTAG 及调试器虚拟寄存器不属于 hart CSR。 触发器在 Debug Mode 中不触发；DMODE=1 时只有 Debug Mode 可修改配置。功能是否实现需通过规范探测。 SCONTEXT 访问受 mstateen0/hstateen0 的 CONTEXT 位控制；比较能力与实际实现宽度相关。"
      },
      "coverage": {
        "set": "fields"
      },
      "fields": {
        "list": "fields",
        "remove": [],
        "items": [
          {
            "key": "DATA",
            "patch": {
              "set": {
                "name": "DATA",
                "summary": "保存供触发器比较的监管态上下文编号，高位可按实现固定为零。",
                "summaryEn": "Hold the supervisor context identifier for trigger comparison; high bits may read zero.",
                "access": "WARL",
                "layouts": [
                  {
                    "xlen": 32,
                    "msb": 31,
                    "lsb": 0
                  },
                  {
                    "xlen": 64,
                    "msb": 31,
                    "lsb": 0
                  }
                ],
                "condition": "",
                "aliases": [
                  "data"
                ],
                "sourceUrl": "https://github.com/riscv/riscv-debug-spec/blob/5695c0aaa7a3c228e14702e1268eb5a5e50e3cb8/xml/hwbp_registers.xml#L251-L269",
                "values": {},
                "valuesEn": {},
                "valuesByXlen": {},
                "valuesEnByXlen": {},
                "typeRule": "",
                "view": ""
              }
            }
          }
        ]
      },
      "regions": {
        "list": "regions",
        "remove": [],
        "items": [
          {
            "key": "|0|64:63:32",
            "patch": {
              "set": {
                "label": "0",
                "access": "RO0",
                "summary": "显式只读零位。",
                "summaryEn": "Explicit read-only-zero bits.",
                "layouts": [
                  {
                    "xlen": 64,
                    "msb": 63,
                    "lsb": 32
                  }
                ],
                "sourceUrl": "https://github.com/riscv/riscv-debug-spec/blob/5695c0aaa7a3c228e14702e1268eb5a5e50e3cb8/xml/hwbp_registers.xml#L251-L269",
                "view": ""
              }
            }
          }
        ]
      },
      "summaryEn": {
        "set": "Hold the supervisor context identifier for trigger filtering."
      },
