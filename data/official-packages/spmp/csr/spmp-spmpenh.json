{
  "id": "riscv/spmp/csr/spmpenh",
  "name": "spmpenh",
  "namespace": "spmp",
  "title": "Enable SPMP entry matching with a bitmap.",
  "summary": "逐位控制 SPMP 条目是否参与匹配。",
  "summaryEn": "Enable SPMP entry matching with a bitmap.",
  "locator": {
    "type": "riscv-csr",
    "address": 403
  },
  "privilege": "S",
  "access": "RW",
  "xlens": [
    32
  ],
  "condition": "Sspmpen",
  "extensions": [
    "Sspmpen"
  ],
  "notes": "Sspmpen；RV32 spmpenh 别名到 spmpen 的高 32 位。超出实现条目的位写忽略；正文未明确其读回值，不推断为 RO0。",
  "sourceUrl": "https://github.com/riscv/riscv-spmp/blob/4ce228207193c55247200110e3d5b6881a17c367/sspmp/spmpswitch.adoc#L1-L40",
