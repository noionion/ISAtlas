      "name": "EN32",
      "summary": "控制 SPMP 条目 32 是否参与匹配；还需 A≠OFF。",
      "summaryEn": "Enable SPMP entry 32; A must also be nonzero.",
      "access": "WARL",
      "layouts": [
        {
          "xlen": 32,
          "msb": 0,
          "lsb": 0
        }
      ],
      "values": {
        "0": "不参与匹配",
        "1": "A≠OFF 时参与匹配"
      },
      "valuesEn": {
        "0": "Inactive",
        "1": "Active if A is nonzero"
      },
      "valuesByXlen": {},
      "valuesEnByXlen": {},
      "aliases": [],
      "typeRule": "条目 L=1 时对应位只读；不控制配置/地址可写性。超出实现条目的位写忽略。更新后需要适用的 SFENCE.VMA/HFENCE.GVMA 同步；TOR 下界与前一条目的使能状态无关。",
      "condition": "",
      "view": "",
