{
  "id": "riscv/manual/csr/sireg",
  "patch": {
    "object": {
      "condition": {
        "append": " / Sspmp（依 selector 对应扩展）",
        "join": false
      },
      "extensions": {
        "add": [
          "Sspmp"
        ],
        "remove": []
      },
      "notes": {
        "append": "SPMP selector 0x100–0x13F：ireg 访问 spmpaddr[i]，ireg2 访问 spmpcfg[i]；越过实际条目数读零、写忽略。ireg3–6 在此 selector 范围保留。 不同间接写及后续访存之间不自动排序；S/U 使用 SFENCE.VMA x0,x0，适用的 VS/VU 使用 HFENCE.GVMA x0,x0。",
        "join": true
      },
      "regions": {
        "list": "regions",
        "remove": [],
        "items": [
          {
            "key": "spmpaddr|0|64:63:54",
            "patch": {
              "set": {
                "label": "0",
                "access": "RO",
                "summary": "规范位图规定为零。",
                "summaryEn": "Zero in the normative diagram.",
                "layouts": [
                  {
                    "xlen": 64,
                    "msb": 63,
                    "lsb": 54
                  }
                ],
                "view": "spmpaddr",
                "sourceUrl": "https://github.com/riscv/riscv-spmp/blob/4ce228207193c55247200110e3d5b6881a17c367/sspmp/images/bytefield/spmpaddr-rv64.adoc#L1-L17"
              }
            }
          }
        ]
      },
