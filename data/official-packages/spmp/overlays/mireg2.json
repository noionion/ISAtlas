{
  "id": "riscv/manual/csr/mireg2",
  "patch": {
    "object": {
      "condition": {
        "append": " / Smpmpdeleg（依 selector 对应扩展）",
        "join": false
      },
      "extensions": {
        "add": [
          "Smpmpdeleg"
        ],
        "remove": []
      },
      "notes": {
        "append": "SPMP selector 0x100–0x13F：ireg 访问 spmpaddr[i]，ireg2 访问 spmpcfg[i]；越过实际条目数读零、写忽略。ireg3–6 在此 selector 范围保留。 不同间接写及后续访存之间不自动排序；S/U 使用 SFENCE.VMA x0,x0，适用的 VS/VU 使用 HFENCE.GVMA x0,x0。",
        "join": true
      },
      "regions": {
        "list": "regions",
        "remove": [],
        "items": [
          {
            "key": "spmpcfg|WPRI|32:6:5,64:6:5",
            "patch": {
              "set": {
                "label": "WPRI",
                "access": "WPRI",
                "summary": "保留，写入时保留原值，读取时忽略。",
                "summaryEn": "Reserved; preserve on writes and ignore on reads.",
                "layouts": [
                  {
                    "xlen": 32,
                    "msb": 6,
                    "lsb": 5
                  },
                  {
                    "xlen": 64,
                    "msb": 6,
