{
  "schemaVersion": 1,
  "id": "riscv/manual/pseudo/vmsgeu.vx",
  "architecture": "riscv",
  "namespace": "manual",
  "name": "vmsgeu.vx",
  "kind": "pseudo",
  "summary": "逐元素比较 va ≥u x，将结果写入掩码。",
  "summaryEn": "Compare vector elements va >= x using unsigned ordering and write mask bits.",
  "xlens": [
    32,
    64
  ],
  "privilege": "U",
  "requires": [
    [
      "V"
    ],
    [
      "Zve32x"
    ]
  ],
  "sourceRevision": "584390d9d872835b1bc45ab9ea946b56db3ad485",
  "license": "CC-BY-4.0",
  "semanticSources": [
    {
      "path": "v-st-ext.adoc",
      "lineStart": 2770,
      "lineEnd": 2811,
      "url": "https://github.com/riscv/riscv-isa-manual/blob/584390d9d872835b1bc45ab9ea946b56db3ad485/src/v-st-ext.adoc#L2770-L2811",
      "sha256": "ae7125cd4e17c944ded93aaa5c8cc30def42523ef0f62f97745ab2b2bacb1a83",
      "method": "manual-pseudoinstruction-expansion"
    }
  ],
  "notes": "vt 是临时向量寄存器，必须不同于 vd，并会被改写。按实际掩码和目的寄存器条件选择序列，仍需满足向量状态及各基础指令的执行条件。",
  "notesEn": "vt is a temporary vector register distinct from vd and is clobbered. Select a sequence using the actual mask and destination conditions; vector state and the underlying instruction requirements still apply.",
  "expansions": [
    {
      "syntax": "vmsgeu.vx vd, va, x",
      "condition": "无掩码",
      "conditionEn": "Unmasked",
      "steps": [
        {
          "name": "vmsltu.vx",
          "assembly": "vmsltu.vx vd, va, x"
        },
        {
          "name": "vmnand.mm",
          "assembly": "vmnand.mm vd, vd, vd"
        }
      ],
      "clobbers": []
    },
    {
      "syntax": "vmsgeu.vx vd, va, x, v0.t",
      "condition": "使用掩码且 vd ≠ v0",
      "conditionEn": "Masked and vd != v0",
      "steps": [
        {
          "name": "vmsltu.vx",
          "assembly": "vmsltu.vx vd, va, x, v0.t"
        },
        {
          "name": "vmxor.mm",
          "assembly": "vmxor.mm vd, vd, v0"
        }
      ],
      "clobbers": []
    },
    {
      "syntax": "vmsgeu.vx vd, va, x, v0.t, vt",
      "condition": "使用掩码且 vd = v0",
      "conditionEn": "Masked and vd == v0",
      "steps": [
        {
          "name": "vmsltu.vx",
          "assembly": "vmsltu.vx vt, va, x"
        },
        {
          "name": "vmandn.mm",
          "assembly": "vmandn.mm vd, vd, vt"
        }
      ],
      "clobbers": [
        "vt"
      ]
    },
    {
      "syntax": "vmsgeu.vx vd, va, x, v0.t, vt",
      "condition": "使用掩码，适用于任意 vd",
      "conditionEn": "Masked, any vd",
      "steps": [
        {
          "name": "vmsltu.vx",
          "assembly": "vmsltu.vx vt, va, x"
        },
        {
          "name": "vmandn.mm",
          "assembly": "vmandn.mm vt, v0, vt"
        },
        {
          "name": "vmandn.mm",
          "assembly": "vmandn.mm vd, vd, v0"
        },
        {
          "name": "vmor.mm",
          "assembly": "vmor.mm vd, vt, vd"
        }
      ],
      "clobbers": [
        "vt"
      ]
    },
    {
      "syntax": "vmsgeu.vx vd, va, x, vm",
      "condition": "x 大于最小可表示值，减一不回绕；t0 为临时整数寄存器",
      "conditionEn": "x is above the minimum and decrement cannot wrap; t0 is a temporary integer register",
      "steps": [
        {
          "name": "addi",
          "assembly": "addi t0, x, -1"
        },
        {
          "name": "vmsgtu.vx",
          "assembly": "vmsgtu.vx vd, va, t0, vm"
        }
      ],
      "clobbers": [
        "t0"
      ]
    }
  ]
}
